<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Billet de sortie : Le futur proche</title>

  <!-- Google Font: Inter for clean, legible typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Pure-JS MP3 Encoder (lame.all.min.js bundle with jsDelivr fallback) for reliable .mp3 audio output -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/lamejs/1.2.1/lame.all.min.js"></script>
  <script>
    if (!window.lamejs) {
      document.write('<script src="https://cdn.jsdelivr.net/npm/lamejs@1.2.1/lame.all.min.js"><\/script>');
    }
  </script>

  <style>
    /* Base typography and smooth transitions */
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background-color: #f4f7fb;
      color: #1e293b;
    }

    /* Subtle shake animation for missing required student name */
    @keyframes gentleShake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-6px); }
      40%, 80% { transform: translateX(6px); }
    }
    .shake-input {
      animation: gentleShake 0.35s ease-in-out;
    }

    /* Pulsing red dot for active recording badge */
    @keyframes pulseDot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.85); }
    }
    .recording-dot {
      animation: pulseDot 1.2s infinite ease-in-out;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between py-6 px-4 sm:px-6 lg:px-8">

  <!-- Main Centered Card Container -->
  <main class="w-full max-w-[780px] mx-auto bg-white rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden">

    <!-- Subtle French-inspired tricolor accent bar -->
    <div class="h-1.5 w-full flex">
      <div class="w-1/3 bg-[#164b9b]"></div>
      <div class="w-1/3 bg-white"></div>
      <div class="w-1/3 bg-[#d9383a]"></div>
    </div>

    <!-- Header Section -->
    <header class="px-6 pt-6 pb-5 sm:px-8 border-b border-slate-100 bg-gradient-to-b from-slate-50/70 to-white">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-[#164b9b] text-white flex items-center justify-center shadow-sm shrink-0" aria-hidden="true">
            <!-- Microphone SVG Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
            </svg>
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-xl sm:text-2xl font-bold text-[#164b9b] tracking-tight">
                Billet de sortie : Le futur proche
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-rose-100 text-[#d9383a] text-xs font-bold uppercase tracking-wide">
                Grammaire &amp; Projets
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
              Prononcez au moins 4 phrases complètes au futur proche (aller + infinitif), puis téléchargez vos 2 fichiers.
            </p>
          </div>
        </div>

        <!-- Live Recording Badge, Timer & Futur Proche Counter -->
        <div id="recordingBadge" class="flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-slate-600 text-sm font-medium transition-colors" title="Objectif : 4 phrases complètes au futur proche">
          <span id="recordingDot" class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
          <span id="recordingLabel" class="text-xs uppercase tracking-wider font-semibold">Prêt</span>
          <span class="text-slate-300">|</span>
          <span id="timer" class="font-mono font-semibold text-slate-800">00:00</span>
          <span class="text-slate-300">|</span>
          <span id="liveFuturBadge" class="text-xs font-bold font-mono text-[#164b9b]">0/4 futur proche</span>
        </div>
      </div>
    </header>

    <!-- Main Form / Step-by-Step Content -->
    <div class="p-6 sm:p-8 space-y-8">

      <!-- ========================================================= -->
      <!-- ÉTAPE 1 : CONSIGNE & IDENTIFICATION                        -->
      <!-- ========================================================= -->
      <section aria-labelledby="step1-heading" class="space-y-4">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-full bg-[#164b9b] text-white text-xs font-bold flex items-center justify-center shadow-sm">
            1
          </span>
          <h2 id="step1-heading" class="text-base sm:text-lg font-semibold text-slate-800">
            Étape 1 : Consigne &amp; Identification
          </h2>
        </div>

        <div class="pl-0 sm:pl-9 space-y-5">

          <!-- Assignment Prompt Card: Billet de sortie • Le futur proche -->
          <div class="rounded-2xl border-2 border-rose-200/90 bg-gradient-to-br from-rose-50/75 via-white to-amber-50/50 p-4 sm:p-5 space-y-3.5 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-rose-100 pb-2.5">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full bg-[#d9383a] text-white text-xs font-bold uppercase tracking-wider">
                  Billet de sortie
                </span>
                <span class="text-xs sm:text-sm font-bold text-slate-800">
                  Grammaire • Le futur proche (aller + infinitif • 4 phrases complètes)
                </span>
              </div>
              <button
                type="button"
                id="toggleModelBtn"
                aria-expanded="true"
                class="px-2.5 py-1 rounded-lg border border-rose-200 bg-white hover:bg-rose-50 text-[#d9383a] text-xs font-semibold transition cursor-pointer shrink-0"
              >
                Masquer le modèle
              </button>
            </div>

            <!-- Prompt Explanation -->
            <p class="text-xs sm:text-sm text-slate-800 leading-relaxed">
              <strong>Prompt :</strong> Talk about <strong>YOUR upcoming plans and healthy food habits</strong> using <strong>le futur proche</strong> (<em>aller</em> in the present tense + an infinitive verb). You must complete at least <strong>4 futur proche</strong> constructions to unlock the download.
            </p>

            <!-- The 4 Target Requirements on Screen -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <div class="rounded-xl bg-white border border-slate-200/90 px-3 py-2 text-xs text-slate-800 flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-[#164b9b] text-white font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">1</span>
                <div>
                  <p class="font-semibold">Aller au présent + infinitif</p>
                  <p class="text-[11px] text-slate-500">Cible : <span class="font-semibold text-[#164b9b]">je vais, tu vas, il/elle/on va, nous allons, vous allez, ils/elles vont + infinitif</span></p>
                </div>
              </div>

              <div class="rounded-xl bg-white border border-slate-200/90 px-3 py-2 text-xs text-slate-800 flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-[#164b9b] text-white font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">2</span>
                <div>
                  <p class="font-semibold">4 phrases complètes</p>
                  <p class="text-[11px] text-slate-500">Cible : <span class="font-semibold text-[#164b9b]">4 constructions complètes au futur proche (ex. : je vais cuisiner)</span></p>
                </div>
              </div>

              <div class="rounded-xl bg-white border border-slate-200/90 px-3 py-2 text-xs text-slate-800 flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-[#164b9b] text-white font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">3</span>
                <div>
                  <p class="font-semibold">Marqueurs du futur</p>
                  <p class="text-[11px] text-slate-500">Cible : <span class="font-semibold text-[#164b9b]">demain, ce soir, ce week-end, bientôt, la semaine prochaine</span></p>
                </div>
              </div>

              <div class="rounded-xl bg-white border border-slate-200/90 px-3 py-2 text-xs text-slate-800 flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-[#164b9b] text-white font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">4</span>
                <div>
                  <p class="font-semibold">Forme négative (optionnel)</p>
                  <p class="text-[11px] text-slate-500">Cible : <span class="font-semibold text-[#164b9b]">ne + aller + pas / plus / jamais + infinitif</span></p>
                </div>
              </div>
            </div>

            <!-- Dashed Model Box -->
            <div id="modelSentencesBox" class="rounded-xl border-2 border-dashed border-rose-300 bg-white/95 px-3.5 py-2.5 text-xs sm:text-sm text-slate-700 leading-relaxed">
              <span class="block text-[11px] font-bold uppercase tracking-wider text-[#d9383a] mb-1">
                💬 Amorces / Modèle de phrases au futur proche :
              </span>
              <p class="italic">
                « Demain, je <strong>vais cuisiner</strong> un repas sain pour être en bonne santé. Ce soir, je <strong>vais déguster</strong> des légumes frais.<br />
                Ce week-end, nous <strong>allons recycler</strong> les bouteilles et nous <strong>n'allons plus gaspiller</strong> de nourriture. La semaine prochaine, je <strong>vais partager</strong> un goûter avec mes amis ! »
              </p>
            </div>

            <!-- Success Criteria Pills -->
            <div class="space-y-1.5">
              <p class="text-[11px] font-bold uppercase tracking-wider text-slate-600">
                Success criteria — 4/4 futur proche required to unlock download:
              </p>
              <div class="flex flex-wrap gap-1.5">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-blue-50 border border-blue-200 text-[#164b9b] text-[11px] font-semibold">
                  ✓ aller au présent (vais, vas, va, allons, allez, vont)
                </span>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-blue-50 border border-blue-200 text-[#164b9b] text-[11px] font-semibold">
                  ✓ Suivi d'un verbe à l'infinitif (-er, -ir, -re, faire, être, etc.)
                </span>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-rose-50 border border-rose-200 text-[#d9383a] text-[11px] font-semibold">
                  ✓ 4 futur proche complets détectés (obligatoire)
                </span>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-blue-50 border border-blue-200 text-[#164b9b] text-[11px] font-semibold">
                  ✓ Négation optionnelle : ne + aller + pas / plus / jamais + infinitif
                </span>
              </div>
            </div>
          </div>

          <!-- Interactive Mode Selection Cards -->
          <div role="radiogroup" aria-label="Choisir le mode d'enregistrement" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <!-- Mode 1: Solo Exit Ticket -->
            <button
              type="button"
              id="modeIndependentBtn"
              role="radio"
              aria-checked="true"
              class="text-left p-4 rounded-xl border-2 border-[#164b9b] bg-blue-50/60 shadow-sm transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#164b9b]/30 disabled:opacity-60 disabled:cursor-not-allowed"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="font-bold text-sm sm:text-base text-[#164b9b]">
                  👤 Solo — Billet de sortie
                </span>
                <span id="modeIndependentCheck" class="w-5 h-5 rounded-full bg-[#164b9b] text-white flex items-center justify-center text-xs font-bold">
                  ✓
                </span>
              </div>
              <p class="text-xs text-slate-600 mt-1">
                1 élève — Présentez vos projets et habitudes avec au moins 4 phrases au futur proche.
              </p>
            </button>

            <!-- Mode 2: Pair Conversation -->
            <button
              type="button"
              id="modePairBtn"
              role="radio"
              aria-checked="false"
              class="text-left p-4 rounded-xl border-2 border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50/70 transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#164b9b]/30 disabled:opacity-60 disabled:cursor-not-allowed"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="font-bold text-sm sm:text-base text-slate-800">
                  👥 Binôme — Échange oral
                </span>
                <span id="modePairCheck" class="w-5 h-5 rounded-full border-2 border-slate-300 text-transparent flex items-center justify-center text-xs font-bold">
                  ✓
                </span>
              </div>
              <p class="text-xs text-slate-600 mt-1">
                2 élèves — Discutez de vos projets à tour de rôle avec au moins 4 phrases au futur proche.
              </p>
            </button>
          </div>

          <!-- Independent Mode Input (1 Student) -->
          <div id="independentInputs">
            <label for="studentName" class="block text-sm font-medium text-slate-700 mb-1.5">
              Nom et prénom de l'élève <span class="text-[#d9383a] font-bold">*</span>
            </label>
            <input
              type="text"
              id="studentName"
              autocomplete="name"
              placeholder="Ex. Marie Dupont"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-slate-800 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-[#164b9b]/30 focus:border-[#164b9b] transition"
            />
          </div>

          <!-- Pair Mode Inputs (2 Students + Swap Order Button) -->
          <div id="pairInputs" class="hidden space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="student1Name" class="block text-sm font-medium text-slate-700 mb-1.5">
                  Élève 1 (commence en premier) <span class="text-[#d9383a] font-bold">*</span>
                </label>
                <input
                  type="text"
                  id="student1Name"
                  placeholder="Ex. Marie Dupont"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-slate-800 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-[#164b9b]/30 focus:border-[#164b9b] transition"
                />
              </div>

              <div>
                <label for="student2Name" class="block text-sm font-medium text-slate-700 mb-1.5">
                  Élève 2 (partenaire) <span class="text-[#d9383a] font-bold">*</span>
                </label>
                <input
                  type="text"
                  id="student2Name"
                  placeholder="Ex. Lucas Martin"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-slate-800 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-[#164b9b]/30 focus:border-[#164b9b] transition"
                />
              </div>
            </div>

            <div class="flex justify-start sm:justify-center">
              <button
                type="button"
                id="swapSpeakersBtn"
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-medium transition cursor-pointer disabled:opacity-45 disabled:cursor-not-allowed"
              >
                <span>⇄ Inverser l'ordre</span>
              </button>
            </div>
          </div>

          <!-- Dialect / Language Selector -->
          <div>
            <label for="language" class="block text-sm font-medium text-slate-700 mb-1.5">
              Dialecte / Langue de transcription
            </label>
            <select
              id="language"
              class="w-full sm:w-72 px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#164b9b]/30 focus:border-[#164b9b] transition"
            >
              <option value="fr-FR">Français (France)</option>
              <option value="fr-CA">Français (Canada)</option>
            </select>
          </div>
        </div>
      </section>

      <hr class="border-slate-100" />

      <!-- ========================================================= -->
      <!-- ÉTAPE 2 : ENREGISTREMENT & TRANSCRIPTION EN DIRECT        -->
      <!-- ========================================================= -->
      <section aria-labelledby="step2-heading" class="space-y-4">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-full bg-[#164b9b] text-white text-xs font-bold flex items-center justify-center shadow-sm">
            2
          </span>
          <h2 id="step2-heading" class="text-base sm:text-lg font-semibold text-slate-800">
            Étape 2 : Enregistrement &amp; Transcription en direct
          </h2>
        </div>

        <div class="pl-0 sm:pl-9 space-y-4">
          <!-- Real-time Audio Waveform / Equalizer Visualizer -->
          <div class="bg-slate-900 rounded-xl p-3.5 border border-slate-800 shadow-inner">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-400 mb-2 px-1">
              <div class="flex items-center gap-2.5">
                <span class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
                  </svg>
                  Signal microphone en direct
                </span>
                <!-- Background Noise Suppression Toggle Pill -->
                <button
                  type="button"
                  id="noiseSuppressToggle"
                  aria-pressed="true"
                  title="Activer ou désactiver la réduction des bruits de fond de la classe"
                  class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 text-[11px] font-medium hover:bg-emerald-500/25 transition cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
                >
                  <span id="noiseSuppressIcon">🔇</span>
                  <span id="noiseSuppressLabel">Anti-bruit : Activé</span>
                </button>
              </div>
              <span id="micHint" class="text-slate-400">En attente du microphone</span>
            </div>
            <div class="w-full h-16 relative">
              <canvas id="visualizer" class="w-full h-full block rounded-lg"></canvas>
            </div>
          </div>

          <!-- Pair Mode Turn-Taking Panel (Shown ONLY when Binôme is selected) -->
          <div
            id="pairTurnPanel"
            class="hidden rounded-xl border-2 border-indigo-200 bg-gradient-to-br from-indigo-50/90 to-blue-50/70 p-4 space-y-3.5 shadow-sm"
          >
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-indigo-900">
                Échange en binôme — Tour de parole
              </span>
              <span class="text-xs text-indigo-700/80">
                Raccourci : <kbd class="px-1.5 py-0.5 rounded bg-white border border-indigo-200 font-mono text-[11px]">Tab</kbd> ou <kbd class="px-1.5 py-0.5 rounded bg-white border border-indigo-200 font-mono text-[11px]">Alt+S</kbd>
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <div
                id="speaker1Badge"
                class="flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-[#164b9b] text-white text-sm font-semibold shadow-sm transition-all"
              >
                <span id="speaker1BadgeText" class="truncate">🎙️ À la parole : Élève 1</span>
              </div>
              <div
                id="speaker2Badge"
                class="flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white/90 border border-slate-200 text-slate-600 text-sm font-medium transition-all"
              >
                <span id="speaker2BadgeText" class="truncate">⏳ En attente : Élève 2</span>
              </div>
            </div>

            <button
              type="button"
              id="passTurnBtn"
              disabled
              class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-600 active:scale-[0.99] text-slate-950 font-bold text-sm sm:text-base shadow-md shadow-amber-500/20 transition cursor-pointer disabled:opacity-45 disabled:shadow-none disabled:cursor-not-allowed"
            >
              <span id="passTurnBtnLabel">🔄 Passer la parole à Élève 2</span>
            </button>
          </div>

          <!-- Primary Recording Control Buttons -->
          <div class="flex flex-wrap items-center gap-3">
            <button
              type="button"
              id="startBtn"
              class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#164b9b] hover:bg-blue-900 active:scale-[0.99] text-white font-semibold text-sm shadow-sm transition cursor-pointer disabled:opacity-45 disabled:cursor-not-allowed"
            >
              <span>● Commencer</span>
            </button>

            <button
              type="button"
              id="stopBtn"
              disabled
              class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#d9383a] hover:bg-red-700 active:scale-[0.99] text-white font-semibold text-sm shadow-sm transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
            >
              <span>■ Arrêter</span>
            </button>

            <button
              type="button"
              id="clearBtn"
              class="inline-flex items-center justify-center gap-1.5 px-4 py-3 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 active:scale-[0.99] text-slate-700 font-medium text-sm transition cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
              <span id="clearBtnLabel">Effacer</span>
            </button>
          </div>

          <!-- Dynamic Status Banner -->
          <div
            id="statusBanner"
            role="status"
            aria-live="polite"
            class="flex items-start gap-2.5 p-3.5 rounded-xl bg-blue-50/80 border border-blue-200/80 text-slate-700 text-sm transition-colors"
          >
            <svg id="statusIcon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#1e3a8a] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
