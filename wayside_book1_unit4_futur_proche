  <script>
    const $ = (id) => document.getElementById(id);

    // State variables
    let mode = 'independent'; // 'independent' | 'pair'
    let activeSpeaker = 1; // 1 | 2
    let noiseSuppression = true;
    let recorder = null;
    let stream = null;
    let chunks = [];
    let recognition = null;
    let finalText = '';
    let mp3Blob = null;
    let audioUrl = '';
    let audioExt = 'mp3';
    let startTimeMs = 0;
    let elapsedSeconds = 0;
    let timerInterval = null;
    let audioCtx = null;
    let analyser = null;
    let animFrameId = null;
    let lastEvaluation = null;

    const Speech = window.SpeechRecognition || window.webkitSpeechRecognition;

    // ---------------------------------------------------------
    // 1. Model Toggle
    // ---------------------------------------------------------
    $('toggleModelBtn').addEventListener('click', () => {
      const box = $('modelSentencesBox');
      const isHidden = box.classList.toggle('hidden');
      $('toggleModelBtn').textContent = isHidden ? 'Afficher le modèle' : 'Masquer le modèle';
      $('toggleModelBtn').setAttribute('aria-expanded', String(!isHidden));
    });

    // ---------------------------------------------------------
    // 2. Solo vs. Binôme Mode Switching & Speaker Controls
    // ---------------------------------------------------------
    function setMode(newMode) {
      if (recorder && recorder.state === 'recording') return;
      mode = newMode;
      const isSolo = mode === 'independent';

      $('modeIndependentBtn').setAttribute('aria-checked', String(isSolo));
      $('modePairBtn').setAttribute('aria-checked', String(!isSolo));

      $('modeIndependentBtn').className = isSolo
        ? 'text-left p-4 rounded-xl border-2 border-[#164b9b] bg-blue-50/60 shadow-sm transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#164b9b]/30 disabled:opacity-60 disabled:cursor-not-allowed'
        : 'text-left p-4 rounded-xl border-2 border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50/70 transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#164b9b]/30 disabled:opacity-60 disabled:cursor-not-allowed';

      $('modePairBtn').className = !isSolo
        ? 'text-left p-4 rounded-xl border-2 border-[#164b9b] bg-blue-50/60 shadow-sm transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#164b9b]/30 disabled:opacity-60 disabled:cursor-not-allowed'
        : 'text-left p-4 rounded-xl border-2 border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50/70 transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#164b9b]/30 disabled:opacity-60 disabled:cursor-not-allowed';

      $('modeIndependentCheck').className = isSolo
        ? 'w-5 h-5 rounded-full bg-[#164b9b] text-white flex items-center justify-center text-xs font-bold'
        : 'w-5 h-5 rounded-full border-2 border-slate-300 text-transparent flex items-center justify-center text-xs font-bold';

      $('modePairCheck').className = !isSolo
        ? 'w-5 h-5 rounded-full bg-[#164b9b] text-white flex items-center justify-center text-xs font-bold'
        : 'w-5 h-5 rounded-full border-2 border-slate-300 text-transparent flex items-center justify-center text-xs font-bold';

      $('independentInputs').classList.toggle('hidden', !isSolo);
      $('pairInputs').classList.toggle('hidden', isSolo);
      $('pairTurnPanel').classList.toggle('hidden', isSolo);
      updateSpeakerBadges();
    }

    $('modeIndependentBtn').addEventListener('click', () => setMode('independent'));
    $('modePairBtn').addEventListener('click', () => setMode('pair'));

    function getSpeakerNames() {
      const s1 = ($('student1Name').value || '').trim() || 'Élève 1';
      const s2 = ($('student2Name').value || '').trim() || 'Élève 2';
      return { s1, s2 };
    }

    function updateSpeakerBadges() {
      const { s1, s2 } = getSpeakerNames();
      const s1Active = activeSpeaker === 1;

      $('speaker1Badge').className = s1Active
        ? 'flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-[#164b9b] text-white text-sm font-semibold shadow-sm transition-all'
        : 'flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white/90 border border-slate-200 text-slate-600 text-sm font-medium transition-all';

      $('speaker2Badge').className = !s1Active
        ? 'flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-[#164b9b] text-white text-sm font-semibold shadow-sm transition-all'
        : 'flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white/90 border border-slate-200 text-slate-600 text-sm font-medium transition-all';

      $('speaker1BadgeText').textContent = (s1Active ? '🎙️ À la parole : ' : '⏳ En attente : ') + s1;
      $('speaker2BadgeText').textContent = (!s1Active ? '🎙️ À la parole : ' : '⏳ En attente : ') + s2;
      $('passTurnBtnLabel').textContent = '🔄 Passer la parole à ' + (s1Active ? s2 : s1);
    }

    ['studentName', 'student1Name', 'student2Name'].forEach((id) => {
      $(id).addEventListener('input', (e) => {
        e.target.classList.remove('border-[#d9383a]');
        if (id !== 'studentName') updateSpeakerBadges();
      });
    });

    $('swapSpeakersBtn').addEventListener('click', () => {
      const tmp = $('student1Name').value;
      $('student1Name').value = $('student2Name').value;
      $('student2Name').value = tmp;
      updateSpeakerBadges();
    });

    function passTurn() {
      if (mode !== 'pair' || !recorder || recorder.state !== 'recording') return;
      const { s1, s2 } = getSpeakerNames();
      activeSpeaker = activeSpeaker === 1 ? 2 : 1;
      const speakerLabel = activeSpeaker === 1 ? s1 : s2;
      finalText = finalText.trim() + (finalText.trim() ? '\n\n' : '') + `[${speakerLabel}] : `;
      $('transcript').value = finalText;
      updateSpeakerBadges();
    }

    $('passTurnBtn').addEventListener('click', passTurn);

    document.addEventListener('keydown', (e) => {
      if (mode === 'pair' && recorder && recorder.state === 'recording') {
        if (e.key === 'Tab' || (e.altKey && e.key.toLowerCase() === 's')) {
          e.preventDefault();
          passTurn();
        }
      }
    });

    // ---------------------------------------------------------
    // 3. Noise Suppression Toggle & Visualizer
    // ---------------------------------------------------------
    $('noiseSuppressToggle').addEventListener('click', () => {
      if (recorder && recorder.state === 'recording') return;
      noiseSuppression = !noiseSuppression;
      $('noiseSuppressToggle').setAttribute('aria-pressed', String(noiseSuppression));
      $('noiseSuppressIcon').textContent = noiseSuppression ? '🔇' : '🎙️';
      $('noiseSuppressLabel').textContent = noiseSuppression ? 'Anti-bruit : Activé' : 'Anti-bruit : Désactivé';
      $('noiseSuppressToggle').className = noiseSuppression
        ? 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 text-[11px] font-medium hover:bg-emerald-500/25 transition cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed'
        : 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-slate-700/70 border border-slate-600 text-slate-300 text-[11px] font-medium hover:bg-slate-700 transition cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed';
    });

    function drawBar(ctx, x, y, w, h, r) {
      if (typeof ctx.roundRect === 'function') {
        ctx.roundRect(x, y, w, h, r);
      } else {
        ctx.rect(x, y, w, h);
      }
    }

    function drawIdleVisualizer() {
      const canvas = $('visualizer');
      const ctx = canvas.getContext('2d');
      canvas.width = canvas.offsetWidth || 640;
      canvas.height = canvas.offsetHeight || 64;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const bars = 44;
      const barWidth = Math.max(3, (canvas.width / bars) - 3);
      for (let i = 0; i < bars; i++) {
        const x = i * (barWidth + 3);
        const h = 6;
        const y = (canvas.height - h) / 2;
        ctx.fillStyle = '#334155';
        ctx.beginPath();
        drawBar(ctx, x, y, barWidth, h, 3);
        ctx.fill();
      }
    }

    function startVisualizer(mediaStream) {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      audioCtx = new AudioContextClass();
      const source = audioCtx.createMediaStreamSource(mediaStream);
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 128;
      source.connect(analyser);

      const bufferLength = analyser.frequencyBinCount;
      const dataArray = new Uint8Array(bufferLength);
      const canvas = $('visualizer');
      const ctx = canvas.getContext('2d');

      function renderFrame() {
        animFrameId = requestAnimationFrame(renderFrame);
        analyser.getByteFrequencyData(dataArray);
        canvas.width = canvas.offsetWidth || 640;
        canvas.height = canvas.offsetHeight || 64;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        const bars = 44;
        const barWidth = Math.max(3, (canvas.width / bars) - 3);
        for (let i = 0; i < bars; i++) {
          const val = dataArray[i % bufferLength] || 0;
          const percent = val / 255;
          const h = Math.max(6, percent * (canvas.height - 8));
          const x = i * (barWidth + 3);
          const y = (canvas.height - h) / 2;
          ctx.fillStyle = percent > 0.55 ? '#38bdf8' : percent > 0.2 ? '#60a5fa' : '#475569';
          ctx.beginPath();
          drawBar(ctx, x, y, barWidth, h, 3);
          ctx.fill();
        }
      }
      renderFrame();
    }

    function stopVisualizer() {
      if (animFrameId) {
        cancelAnimationFrame(animFrameId);
        animFrameId = null;
      }
      if (audioCtx) {
        audioCtx.close().catch(() => {});
        audioCtx = null;
      }
      drawIdleVisualizer();
    }

    window.addEventListener('resize', () => {
      if (!animFrameId) drawIdleVisualizer();
    });
    drawIdleVisualizer();

    // ---------------------------------------------------------
    // 4. Helpers: Status, Timer, Word Count, Live Futur Proche Counter
    // ---------------------------------------------------------
    function setStatus(text, tone = 'info') {
      $('statusText').textContent = text;
      const banner = $('statusBanner');
      if (tone === 'recording') {
        banner.className = 'flex items-start gap-2.5 p-3.5 rounded-xl bg-rose-50/90 border border-rose-200 text-rose-950 text-sm transition-colors';
      } else if (tone === 'success') {
        banner.className = 'flex items-start gap-2.5 p-3.5 rounded-xl bg-emerald-50/90 border border-emerald-200 text-emerald-950 text-sm transition-colors';
      } else if (tone === 'error') {
        banner.className = 'flex items-start gap-2.5 p-3.5 rounded-xl bg-amber-50/90 border border-amber-200 text-amber-950 text-sm transition-colors';
      } else {
        banner.className = 'flex items-start gap-2.5 p-3.5 rounded-xl bg-blue-50/80 border border-blue-200/80 text-slate-700 text-sm transition-colors';
      }
    }

    function formatTime(sec) {
      const m = Math.floor(sec / 60);
      const s = sec % 60;
      return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    }

    function updateLiveFuturBadge(count) {
      const badge = $('liveFuturBadge');
      const clamped = Math.min(count, 4);
      if (count >= 4) {
        badge.textContent = `${count}/4 futur proche ✓`;
        badge.className = 'text-xs font-bold font-mono text-emerald-700';
      } else {
        badge.textContent = `${clamped}/4 futur proche`;
        badge.className = 'text-xs font-bold font-mono text-[#164b9b]';
      }
    }

    function updateTimerDisplay(isRecording) {
      $('timer').textContent = formatTime(elapsedSeconds);
      const badge = $('recordingBadge');
      const dot = $('recordingDot');
      const label = $('recordingLabel');

      const currentCount = detectFuturProcheConstructions($('transcript').value).completed.length;
      updateLiveFuturBadge(currentCount);

      if (currentCount >= 4) {
        badge.className = 'flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-300 text-emerald-800 text-sm font-medium transition-colors';
        dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500' + (isRecording ? ' recording-dot' : '');
        label.textContent = isRecording ? 'Objectif ✓' : 'Terminé';
      } else if (isRecording) {
        badge.className = 'flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-rose-50 border border-rose-200 text-[#d9383a] text-sm font-medium transition-colors';
        dot.className = 'w-2.5 h-2.5 rounded-full bg-[#d9383a] recording-dot';
        label.textContent = 'En direct';
      } else {
        badge.className = 'flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-slate-600 text-sm font-medium transition-colors';
        dot.className = 'w-2.5 h-2.5 rounded-full bg-slate-400';
        label.textContent = 'Prêt';
      }
    }

