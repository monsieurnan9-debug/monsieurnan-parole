    }

    // ---------------------------------------------------------
    // 7. Recording Start / Stop & SpeechRecognition
    // ---------------------------------------------------------
    function unlockControlsAfterRecording() {
      $('startBtn').disabled = false;
      $('stopBtn').disabled = true;
      $('passTurnBtn').disabled = true;
      $('modeIndependentBtn').disabled = false;
      $('modePairBtn').disabled = false;
      $('swapSpeakersBtn').disabled = false;
      $('noiseSuppressToggle').disabled = false;
    }

    $('startBtn').addEventListener('click', async () => {
      if (!validateNames()) return;

      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        setStatus('Votre navigateur ne prend pas en charge l\'enregistrement microphone.', 'error');
        return;
      }

      try {
        stream = await navigator.mediaDevices.getUserMedia({
          audio: {
            echoCancellation: true,
            noiseSuppression: noiseSuppression,
            autoGainControl: true
          }
        });

        chunks = [];
        finalText = '';
        mp3Blob = null;
        lastEvaluation = null;
        if (audioUrl) {
          URL.revokeObjectURL(audioUrl);
          audioUrl = '';
        }

        $('playback').removeAttribute('src');
        $('grammarFeedbackSection').classList.add('hidden');
        $('downloadLockNotice').classList.add('hidden');
        $('downloadConfirmBadge').classList.add('hidden');
        $('downloadBothBtn').disabled = true;
        $('audioDownload').disabled = true;
        $('textDownload').disabled = true;
        updateLiveFuturBadge(0);

        if (mode === 'pair') {
          activeSpeaker = 1;
          updateSpeakerBadges();
          const { s1 } = getSpeakerNames();
          finalText = `[${s1}] : `;
          $('passTurnBtn').disabled = false;
        }
        $('transcript').value = finalText;
        updateWordCount();

        // Lock mode/name inputs while recording
        $('modeIndependentBtn').disabled = true;
        $('modePairBtn').disabled = true;
        $('swapSpeakersBtn').disabled = true;
        $('noiseSuppressToggle').disabled = true;

        const mimeType =
          typeof MediaRecorder !== 'undefined' && typeof MediaRecorder.isTypeSupported === 'function'
            ? ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4'].find((t) => MediaRecorder.isTypeSupported(t))
            : undefined;
        recorder = new MediaRecorder(stream, mimeType ? { mimeType } : undefined);
        const nativeExt = (recorder.mimeType || '').includes('mp4') ? 'm4a' : 'webm';

        recorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) chunks.push(e.data);
        };

        recorder.onstop = async () => {
          clearInterval(timerInterval);
          elapsedSeconds = Math.max(1, Math.round((Date.now() - startTimeMs) / 1000));
          updateTimerDisplay(false);
          stopVisualizer();

          if (stream) {
            stream.getTracks().forEach((t) => t.stop());
            stream = null;
          }
          $('micHint').textContent = 'Microphone arrêté';

          setStatus('Encodage MP3 et analyse de vos phrases au futur proche en cours...', 'info');

          const rawBlob = new Blob(chunks, { type: recorder.mimeType || 'audio/webm' });
          const converted = await convertToMp3(rawBlob, nativeExt);
          mp3Blob = converted.blob;
          audioExt = converted.ext;

          audioUrl = URL.createObjectURL(mp3Blob);
          $('playback').src = audioUrl;

          unlockControlsAfterRecording();

          const evaluation = evaluateFuturProche($('transcript').value, elapsedSeconds);
          renderFeedbackUI(evaluation);
          updateLiveFuturBadge(evaluation.completedCount);

          // Unlock download buttons ONLY when 4/4 completed futur proche constructions are detected
          const canDownload = evaluation.completedCount >= 4;
          $('downloadBothBtn').disabled = !canDownload;
          $('audioDownload').disabled = !canDownload;
          $('textDownload').disabled = !canDownload;

          if (canDownload) {
            $('downloadLockNotice').classList.add('hidden');
            setStatus(
              `Enregistrement terminé ! ${evaluation.completedCount}/4 phrases au futur proche détectées. Lisez votre feedback, puis téléchargez vos 2 fichiers.`,
              'success'
            );
          } else {
            $('downloadLockText').innerHTML =
              `Téléchargement verrouillé (<strong>${evaluation.completedCount}/4 futur proche</strong>) : prononcez au moins <strong>4 phrases complètes au futur proche (aller + infinitif)</strong> pour débloquer vos fichiers. Cliquez sur <strong>Reattempt Recording</strong> pour réessayer !`;
            $('downloadLockNotice').classList.remove('hidden');
            setStatus(
              `Téléchargement verrouillé (${evaluation.completedCount}/4 futur proche). Prononcez au moins 4 phrases complètes au futur proche pour débloquer vos fichiers.`,
              'error'
            );
          }
        };

        recorder.start(500);
        startVisualizer(stream);
        $('micHint').textContent = 'Microphone actif';

        startTimeMs = Date.now();
        elapsedSeconds = 0;
        updateTimerDisplay(true);
        timerInterval = setInterval(() => {
          elapsedSeconds = Math.floor((Date.now() - startTimeMs) / 1000);
          updateTimerDisplay(true);
        }, 250);

        $('startBtn').disabled = true;
        $('stopBtn').disabled = false;

        if (Speech) {
          recognition = new Speech();
          recognition.lang = $('language').value;
          recognition.continuous = true;
          recognition.interimResults = true;

          recognition.onresult = (e) => {
            let interim = '';
            for (let i = e.resultIndex; i < e.results.length; i++) {
              const seg = e.results[i][0].transcript;
              if (e.results[i].isFinal) {
                finalText += seg + ' ';
              } else {
                interim += seg;
              }
            }
            $('transcript').value = (finalText + interim).trim();
            updateWordCount();
          };

          recognition.onerror = (e) => {
            if (e.error !== 'no-speech') {
              setStatus('Enregistrement audio actif (remarque transcription : ' + e.error + ').', 'recording');
            }
          };

          recognition.onend = () => {
            if (recorder && recorder.state === 'recording') {
              try {
                recognition.start();
              } catch (err) {}
            }
          };

          try {
            recognition.start();
            setStatus('🎙️ Enregistrement en cours... Prononcez au moins 4 phrases complètes au futur proche (aller + infinitif).', 'recording');
          } catch (err) {
            setStatus('🎙️ Enregistrement audio en cours...', 'recording');
          }
        } else {
          setStatus('🎙️ Enregistrement audio en cours (reconnaissance vocale non disponible sur ce navigateur).', 'recording');
        }
      } catch (err) {
        if (stream) {
          stream.getTracks().forEach((t) => t.stop());
          stream = null;
        }
        stopVisualizer();
        unlockControlsAfterRecording();
        setStatus('Erreur microphone : ' + err.message, 'error');
      }
    });

    $('stopBtn').addEventListener('click', () => {
      $('stopBtn').disabled = true;
      if (recognition) {
        try {
          recognition.onend = null;
          recognition.stop();
        } catch (err) {}
      }
      if (recorder && recorder.state !== 'inactive') {
        recorder.stop();
      } else {
        unlockControlsAfterRecording();
      }
    });

    // ---------------------------------------------------------
    // 8. Reset / Reattempt Confirmation Modal
    // ---------------------------------------------------------
    function resetSession() {
      if (recorder && recorder.state === 'recording') {
        $('stopBtn').click();
      }
      if (audioUrl) {
        URL.revokeObjectURL(audioUrl);
        audioUrl = '';
      }
      mp3Blob = null;
      chunks = [];
      finalText = '';
      elapsedSeconds = 0;
      lastEvaluation = null;

      $('transcript').value = '';
      updateWordCount();
      updateTimerDisplay(false);
      $('playback').removeAttribute('src');
      $('grammarFeedbackSection').classList.add('hidden');
      $('downloadLockNotice').classList.add('hidden');
      $('downloadConfirmBadge').classList.add('hidden');
      $('downloadBothBtn').disabled = true;
      $('audioDownload').disabled = true;
      $('textDownload').disabled = true;

      setStatus('Prêt pour un nouvel essai. Cliquez sur « ● Commencer » et prononcez 4 phrases complètes au futur proche !', 'info');
    }

    function openConfirmModal() {
      $('confirmModal').classList.remove('hidden');
    }
    function closeConfirmModal() {
      $('confirmModal').classList.add('hidden');
    }

    $('clearBtn').addEventListener('click', () => {
      if ($('transcript').value.trim() || mp3Blob) {
        openConfirmModal();
      } else {
        resetSession();
      }
    });

    $('reattemptBtn').addEventListener('click', openConfirmModal);
    $('cancelModalBtn').addEventListener('click', closeConfirmModal);
    $('confirmModalBtn').addEventListener('click', () => {
      closeConfirmModal();
      resetSession();
    });

    // ---------------------------------------------------------
    // 9. Dual File Download (.mp3 + .txt)
    // ---------------------------------------------------------
    function triggerDownload(blob, filename) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 2500);
    }

    function buildReportText() {
      const studentLabel =
        mode === 'independent'
          ? ($('studentName').value || '').trim() || 'Non renseigné'
          : `${getSpeakerNames().s1} & ${getSpeakerNames().s2} (Binôme)`;
      const transcript = ($('transcript').value || '').trim() || '(Aucune transcription capturée)';
      const ev = lastEvaluation || evaluateFuturProche(transcript, elapsedSeconds);
      const dateStr = new Date().toLocaleString('fr-FR');

      const detectedList = ev.completed.length
        ? ev.completed.map((c, idx) => `  ${idx + 1}. ${c.phrase}`).join('\n')
        : '  (Aucune structure complète détectée)';

      return [
        '================================================================',
        'BILLET DE SORTIE : LE FUTUR PROCHE (FRANÇAIS)',
        '================================================================',
        `Élève(s) : ${studentLabel}`,
        `Mode : ${mode === 'independent' ? 'Solo — Billet de sortie' : 'Binôme — Échange oral'}`,
        `Date : ${dateStr}`,
        `Durée : ${formatTime(ev.durationSec)} (${ev.durationSec}s)`,
        `Score futur proche : ${ev.completedCount} / 4 requis`,
        '',
        '--- CONSTRUCTIONS AU FUTUR PROCHE DÉTECTÉES ---',
        detectedList,
        '',
        `Marqueurs du futur détectés : ${ev.detectedMarkers.join(', ') || 'aucun'}`,
        `Forme négative détectée : ${ev.negativeConstructions.join(', ') || 'non'}`,
        '',
        '--- TRANSCRIPTION EN FRANÇAIS ---',
        transcript,
        ''
      ].join('\n');
    }

    function downloadAudioOnly() {
      if (!mp3Blob || !lastEvaluation || lastEvaluation.completedCount < 4) return;
      triggerDownload(mp3Blob, `${getFileBaseName()}.${audioExt}`);
    }

    function downloadTextOnly() {
      if (!lastEvaluation || lastEvaluation.completedCount < 4) return;
      const txtBlob = new Blob([buildReportText()], { type: 'text/plain;charset=utf-8' });
      triggerDownload(txtBlob, `${getFileBaseName()}.txt`);
    }

    $('downloadBothBtn').addEventListener('click', () => {
      if (!lastEvaluation || lastEvaluation.completedCount < 4) return;
      downloadAudioOnly();
      setTimeout(() => {
        downloadTextOnly();
        $('downloadConfirmBadge').classList.remove('hidden');
      }, 350);
    });

    $('audioDownload').addEventListener('click', downloadAudioOnly);
    $('textDownload').addEventListener('click', downloadTextOnly);
  </script>

</body>
