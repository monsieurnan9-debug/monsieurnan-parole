    // ---------------------------------------------------------
    // 5. MP3 Audio Encoding via lamejs
    // ---------------------------------------------------------
    async function convertToMp3(rawBlob, fallbackExt) {
      try {
        if (!window.lamejs || !window.lamejs.Mp3Encoder) {
          return { blob: rawBlob, ext: fallbackExt };
        }
        const arrayBuf = await rawBlob.arrayBuffer();
        const Ctx = window.AudioContext || window.webkitAudioContext;
        const decodeCtx = new Ctx();
        const audioBuf = await decodeCtx.decodeAudioData(arrayBuf);
        await decodeCtx.close();

        const sampleRate = audioBuf.sampleRate;
        const channelData = audioBuf.getChannelData(0);
        const samples = new Int16Array(channelData.length);
        for (let i = 0; i < channelData.length; i++) {
          const s = Math.max(-1, Math.min(1, channelData[i]));
          samples[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
        }

        const encoder = new window.lamejs.Mp3Encoder(1, sampleRate, 128);
        const mp3Chunks = [];
        const step = 1152;
        for (let i = 0; i < samples.length; i += step) {
          const slice = samples.subarray(i, i + step);
          const buf = encoder.encodeBuffer(slice);
          if (buf.length > 0) mp3Chunks.push(buf);
        }
        const tail = encoder.flush();
        if (tail.length > 0) mp3Chunks.push(tail);

        return {
          blob: new Blob(mp3Chunks, { type: 'audio/mp3' }),
          ext: 'mp3'
        };
      } catch (err) {
        console.warn('MP3 fallback used:', err);
        return { blob: rawBlob, ext: fallbackExt };
      }
    }

    // ---------------------------------------------------------
    // 6. Futur Proche Detection & English Feedback Engine
    // ---------------------------------------------------------
    const NON_INFINITIVE_WORDS = new Set([
      // -er nouns / adjectives / adverbs
      'mer', 'fer', 'ver', 'hier', 'cher', 'super', 'hyper', 'hiver', 'enfer',
      'cancer', 'laser', 'poster', 'burger', 'leader', 'water', 'cahier', 'papier',
      'dossier', 'panier', 'quartier', 'métier', 'escalier', 'oreiller', 'soulier',
      'collier', 'tablier', 'grenier', 'sentier', 'chantier', 'courrier', 'policier',
      'cuisinier', 'infirmier', 'pompier', 'boulanger', 'boucher', 'épicier',
      'fermier', 'jardinier', 'menuisier', 'plombier', 'sorcier', 'chevalier',
      'prisonnier', 'étranger', 'passager', 'voyageur', 'léger', 'dernier',
      'premier', 'entier', 'particulier', 'régulier', 'familier', 'singulier',
      // -ir nouns / adjectives
      'soir', 'noir', 'espoir', 'miroir', 'tiroir', 'trottoir', 'couloir',
      'plaisir', 'loisir', 'désir', 'avenir', 'air', 'clair', 'chair', 'pair',
      'impair', 'cuir',
      // -re nouns / prepositions / numbers
      'heure', 'heures', 'fleur', 'sœur', 'soeur', 'cœur', 'coeur', 'beurre',
      'livre', 'arbre', 'chambre', 'nombre', 'membre', 'septembre', 'octobre',
      'novembre', 'décembre', 'autre', 'notre', 'votre', 'quatre', 'centre',
      'ventre', 'montre', 'rencontre', 'contre', 'entre', 'outre', 'encre',
      'sucre', 'poivre', 'vinaigre', 'cidre', 'cadre', 'ordre', 'désordre',
      'titre', 'chapitre', 'lettre', 'fenêtre', 'maître', 'prêtre', 'théâtre',
      'kilomètre', 'mètre', 'centimètre', 'litre', 'filtre', 'monstre', 'ministre',
      'registre', 'sinistre', 'verre', 'terre', 'pierre', 'guerre', 'tonnerre',
      'serre', 'équerre', 'encore'
    ]);

    function isFrenchInfinitive(word) {
      if (!word) return false;
      const clean = word.toLowerCase().replace(/^[’']|[.,!?;:()«»"“”]+$/g, '');
      if (clean.length < 4 || NON_INFINITIVE_WORDS.has(clean)) return false;
      if (clean === 'être' || clean === 'etre') return true;
      return /^[a-zàâäéèêëîïôöùûüç-]+(?:er|ir|re)$/.test(clean);
    }

    function detectFuturProcheConstructions(transcriptText) {
      const cleanedText = (transcriptText || '')
        .replace(/\[[^\]]+\]\s*:\s*/g, ' ')
        .trim();

      if (!cleanedText) {
        return { completed: [], incompleteAllerCount: 0, negativeConstructions: [] };
      }

      // Tokenize keeping apostrophe-attached clitics together or separated cleanly
      const rawTokens = cleanedText
        .replace(/([’'])/g, '$1 ')
        .split(/\s+/)
        .map((t) => t.replace(/^[.,!?;:()«»"“”]+|[.,!?;:()«»"“”]+$/g, ''))
        .filter(Boolean);

      const ALLER_PRESENT = new Set(['vais', 'vas', 'va', 'allons', 'allez', 'vont']);
      const ALLOWED_MIDDLE = new Set([
        'pas', 'plus', 'jamais', 'rien', 'point', 'guère',
        'bien', 'vite', 'souvent', 'toujours', 'encore', 'aussi', 'peut-être',
        'sûrement', 'vraiment', 'probablement', 'bientôt', 'ensuite', 'donc',
        'alors', 'tout', 'tous', 'enfin', 'déjà', 'presque', 'mieux',
        'me', "m'", 'te', "t'", 'se', "s'", 'nous', 'vous', 'le', 'la', "l'",
        'les', 'lui', 'leur', 'y', 'en',
        'tu', 'il', 'elle', 'on', 'ils', 'elles', 't-il', 't-elle', 't-on'
      ]);
      const NEG_WORDS = new Set(['pas', 'plus', 'jamais', 'rien', 'point', 'guère']);

      const completed = [];
      const negativeConstructions = [];
      let incompleteAllerCount = 0;

      for (let i = 0; i < rawTokens.length; i++) {
        const tokLower = rawTokens[i].toLowerCase();
        // Handle inverted forms like "vas-tu", "allons-nous"
        const baseVerb = tokLower.split('-')[0];
        if (!ALLER_PRESENT.has(baseVerb)) continue;

        let foundInfinitiveIndex = -1;
        let hasNeg = false;

        // Look ahead up to 4 tokens for an infinitive verb
        for (let step = 1; step <= 4 && i + step < rawTokens.length; step++) {
          const candidate = rawTokens[i + step];
          const candLower = candidate.toLowerCase();

          if (isFrenchInfinitive(candLower)) {
            foundInfinitiveIndex = i + step;
            break;
          }
          if (NEG_WORDS.has(candLower)) {
            hasNeg = true;
            continue;
          }
          if (ALLOWED_MIDDLE.has(candLower)) {
            continue;
          }
          // Stop scanning if we hit a non-modifier word (e.g., preposition "au", "à", noun, etc.)
          break;
        }

        if (foundInfinitiveIndex !== -1) {
          // Include preceding subject/ne if present for clearer display
          let startIdx = i;
          if (i >= 1 && ["ne", "n'", "n’"].includes(rawTokens[i - 1].toLowerCase())) {
            startIdx = i - 1;
            hasNeg = true;
          }
          if (startIdx >= 1 && /^(je|j['’]|tu|il|elle|on|nous|vous|ils|elles)$/i.test(rawTokens[startIdx - 1])) {
            startIdx = startIdx - 1;
          }

          const phrase = rawTokens
            .slice(startIdx, foundInfinitiveIndex + 1)
            .join(' ')
            .replace(/([’'])\s+/g, '$1');

          completed.push({
            phrase,
            allerForm: baseVerb,
            infinitive: rawTokens[foundInfinitiveIndex].toLowerCase(),
            isNegative: hasNeg
          });

          if (hasNeg) {
            negativeConstructions.push(phrase);
          }

          i = foundInfinitiveIndex;
        } else {
          incompleteAllerCount++;
        }
      }

      return { completed, incompleteAllerCount, negativeConstructions };
    }

    function evaluateFuturProche(transcriptText, durationSec) {
      const cleanedText = (transcriptText || '')
        .replace(/\[[^\]]+\]\s*:\s*/g, ' ')
        .trim();
      const lower = cleanedText.toLowerCase();

      const { completed, incompleteAllerCount, negativeConstructions } = detectFuturProcheConstructions(cleanedText);
      const completedCount = completed.length;
      const scoreOutOf4 = Math.min(completedCount, 4);

      // Detect future time markers (bonus feedback)
      const markerPatterns = [
        { label: 'demain', regex: /(?:^|[^a-zA-ZÀ-ÿ])demain(?=$|[^a-zA-ZÀ-ÿ])/i },
        { label: 'ce soir', regex: /(?:^|[^a-zA-ZÀ-ÿ])ce\s+soir(?=$|[^a-zA-ZÀ-ÿ])/i },
        { label: 'ce week-end', regex: /(?:^|[^a-zA-ZÀ-ÿ])ce\s+week-?end(?=$|[^a-zA-ZÀ-ÿ])/i },
        { label: 'bientôt', regex: /(?:^|[^a-zA-ZÀ-ÿ])bient[ôo]t(?=$|[^a-zA-ZÀ-ÿ])/i },
        { label: 'la semaine prochaine', regex: /(?:^|[^a-zA-ZÀ-ÿ])(?:la\s+)?semaine\s+prochaine(?=$|[^a-zA-ZÀ-ÿ])/i },
        { label: 'cet après-midi', regex: /(?:^|[^a-zA-ZÀ-ÿ])cet\s+apr[èe]s-?midi(?=$|[^a-zA-ZÀ-ÿ])/i },
        { label: 'plus tard', regex: /(?:^|[^a-zA-ZÀ-ÿ])plus\s+tard(?=$|[^a-zA-ZÀ-ÿ])/i }
      ];
      const detectedMarkers = markerPatterns.filter((m) => m.regex.test(lower)).map((m) => m.label);

      // Build English encouragement & actionable suggestions
      let encouragement = '';
      if (!cleanedText) {
        encouragement = 'No French speech was detected in the transcript. Check that your microphone is unmuted, speak clearly in French, and click Reattempt Recording.';
      } else if (completedCount >= 4) {
        encouragement = `Bravo ! You completed ${completedCount} futur proche construction${completedCount > 1 ? 's' : ''} (4/4 required) in ${durationSec}s. Review your checklist below and download your 2 files.`;
      } else if (completedCount >= 2) {
        const remaining = 4 - completedCount;
        encouragement = `Bon début ! You completed ${completedCount} out of 4 required futur proche structures. Add ${remaining} more sentence${remaining > 1 ? 's' : ''} with aller + infinitive to unlock the download.`;
      } else {
        encouragement = `You have ${completedCount}/4 futur proche structures so far. Remember the formula: subject + aller (vais, vas, va, allons, allez, vont) + infinitive verb (e.g., Je vais cuisiner...).`;
      }

      const suggestions = [];

      if (completedCount < 4) {
        const needed = 4 - completedCount;
        suggestions.push({
          title: `Add ${needed} more futur proche sentence${needed > 1 ? 's' : ''} (${completedCount}/4 detected)`,
          detail: 'Use <strong>aller</strong> in the present tense followed directly by an infinitive verb (e.g., <em>Demain, je vais préparer une salade</em> or <em>Nous allons recycler les bouteilles</em>).'
        });
      }

      if (incompleteAllerCount > 0) {
        suggestions.push({
          title: 'Follow aller with an infinitive verb',
          detail: 'You used a form of <em>aller</em> without an infinitive verb after it (such as <em>je vais au parc</em> or <em>je vais bien</em>). To form <strong>le futur proche</strong>, place an infinitive right after <em>aller</em> (e.g., <em>je vais manger</em>, <em>je vais faire</em>).'
        });
      }

      if (detectedMarkers.length === 0) {
        suggestions.push({
          title: 'Include a future time marker (recommended)',
          detail: 'Anchor your plans in the future with expressions like <em>demain</em> (tomorrow), <em>ce soir</em> (tonight), <em>ce week-end</em>, <em>bientôt</em>, or <em>la semaine prochaine</em>.'
        });
      }

      if (negativeConstructions.length === 0) {
        suggestions.push({
          title: 'Optional challenge: Try a negative futur proche',
          detail: 'Place <strong>ne / n\'</strong> and <strong>pas / plus / jamais</strong> around <em>aller</em>, before the infinitive (e.g., <em>Je ne vais pas gaspiller de nourriture</em>).'
        });
      }

      return {
        completed,
        completedCount,
        scoreOutOf4,
        incompleteAllerCount,
        negativeConstructions,
        detectedMarkers,
        durationSec,
        encouragement,
        suggestions
      };
    }

